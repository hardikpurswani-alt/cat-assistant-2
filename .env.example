# ==============================================================================
# CBT ASSISTANT AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure the values for your deployment environment.

# ─── Application Settings ─────────────────────────────────────────────────────
APP_NAME="CBT Assistant AI"
APP_VERSION="1.1.0"
APP_ENV="development" # "development", "staging", or "production"
DEBUG=true

# ─── Database Configuration ───────────────────────────────────────────────────
# Option 1: Zero-configuration Async SQLite (Default for local development)
DATABASE_URL="sqlite+aiosqlite:///data/cbt_production.db"

# Option 2: Production PostgreSQL with asyncpg (Recommended for production & Docker)
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/cbt_assistant"

# ─── Security & Authentication (JWT + Argon2id) ──────────────────────────────
# Generate a cryptographically strong secret with: openssl rand -hex 32
SECRET_KEY="replace-this-with-a-secure-random-32-byte-hex-string-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── CORS Origins ─────────────────────────────────────────────────────────────
# Comma-separated list or JSON array of allowed origins
CORS_ORIGINS="*"

# ─── Server Binding ───────────────────────────────────────────────────────────
HOST="0.0.0.0"
PORT=8000

# ─── AI Provider & LLM Configuration ──────────────────────────────────────────
# Provider options: "gateway" (OpenAI-compatible) or "ollama" (local)
AI_PROVIDER="gateway"
OPENAI_BASE_URL="http://103.73.181.90:4000/v1"
OPENAI_API_KEY="your_gateway_api_key_here"
LLM_MODEL="qwen-7b"
EMBEDDING_MODEL="embed"
RAG_SCORE_THRESHOLD=0.48

# Ollama fallback (when AI_PROVIDER="ollama")
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="qwen2.5:7b-instruct"
